@page "/teachers/create"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@inject IDbContextFactory<Academy2Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Teacher</h2>
<hr />
<div class="row">
    <div class="col-md-6">
        <EditForm Model="formModel" OnValidSubmit="AddTeacher" FormName="create-teacher">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            
            <div class="mb-3">
                <label for="work_since" class="form-label">work_since:</label>
                <InputDate id="work_since" @bind-Value="formModel.work_since" class="form-control" />
                <ValidationMessage For="() => formModel.work_since" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="rate" class="form-label">rate:</label>
                <InputNumber id="rate" @bind-Value="formModel.rate" class="form-control" />
                <ValidationMessage For="() => formModel.rate" class="text-danger" />
            </div>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="last_name" class="form-label">last_name:</label>
                <InputText id="last_name" @bind-Value="formModel.last_name" class="form-control" aria-required="true" />
                <ValidationMessage For="() => formModel.last_name" class="text-danger" />
            </div>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="first_name" class="form-label">first_name:</label>
                <InputText id="first_name" @bind-Value="formModel.first_name" class="form-control" aria-required="true" />
                <ValidationMessage For="() => formModel.first_name" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="middle_name" class="form-label">middle_name:</label>
                <InputText id="middle_name" @bind-Value="formModel.middle_name" class="form-control" />
                <ValidationMessage For="() => formModel.middle_name" class="text-danger" />
            </div>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="birth_date" class="form-label">birth_date:</label>
                <InputDate id="birth_date" @bind-Value="formModel.birth_date" class="form-control" aria-required="true" />
                <ValidationMessage For="() => formModel.birth_date" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">email:</label>
                <InputText id="email" @bind-Value="formModel.email" class="form-control" />
                <ValidationMessage For="() => formModel.email" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="phone" class="form-label">phone:</label>
                <InputText id="phone" @bind-Value="formModel.phone" class="form-control" />
                <ValidationMessage For="() => formModel.phone" class="text-danger" />
            </div>

            <div class="mb-3">
                <label class="form-label"><strong>Назначить дисциплины:</strong></label>
                @if (allDisciplines is null)
                {
                    <p><em>Загрузка дисциплин...</em></p>
                }
                else
                {
                    <div class="card p-3" style="max-height: 200px; overflow-y: auto;">
                        @foreach (var discipline in allDisciplines)
                        {
                            var dId = discipline.discipline_id;
                            <div class="form-check mb-1">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="discipline_@dId"
                                       checked="@selectedDisciplineIds.Contains(dId)"
                                       @onchange="(e) => ToggleDiscipline(dId, e.Value)" />
                                <label class="form-check-label" for="discipline_@dId">
                                    @discipline.discipline_name
                                </label>
                            </div>
                        }
                    </div>
                }
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/teachers">Back to List</a>
</div>

@code
{
    private Teacher formModel = new();
    private List<Discipline>? allDisciplines;
    private HashSet<int> selectedDisciplineIds = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        allDisciplines = await context.Disciplines.ToListAsync();
        
        formModel.work_since = DateOnly.FromDateTime(DateTime.Now);
        formModel.birth_date = DateOnly.FromDateTime(DateTime.Now.AddYears(-30));
    }

    private void ToggleDiscipline(int disciplineId, object? isChecked)
    {
        if (isChecked is bool checkedValue && checkedValue)
        {
            selectedDisciplineIds.Add(disciplineId);
        }
        else
        {
            selectedDisciplineIds.Remove(disciplineId);
        }
    }

    private async Task AddTeacher()
    {
        using var context = DbFactory.CreateDbContext();
        
        // Создаем преподавателя
        var dbTeacher = new Teacher
        {
            last_name = formModel.last_name,
            first_name = formModel.first_name,
            middle_name = formModel.middle_name,
            rate = formModel.rate,
            work_since = formModel.work_since,
            birth_date = formModel.birth_date,
            email = formModel.email,
            phone = formModel.phone
        };

        context.Teachers.Add(dbTeacher);
        
        // Сначала сохраняем, чтобы база данных сгенерировала нам первичный ключ `teacher_id`
        await context.SaveChangesAsync();

        // Теперь, используя сгенерированный ID преподавателя, добавляем связи в промежуточную таблицу
        foreach (var disciplineId in selectedDisciplineIds)
        {
            var relation = new TeacherDiscipline
            {
                teacher_id = dbTeacher.teacher_id,
                discipline_id = disciplineId
            };
            context.TeacherDisciplines.Add(relation);
        }

        // Сохраняем связи
        await context.SaveChangesAsync();
        
        NavigationManager.NavigateTo("/teachers");
    }
}
