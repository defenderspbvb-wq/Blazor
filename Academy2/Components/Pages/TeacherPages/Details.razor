@page "/teachers/details"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@inject IDbContextFactory<Academy2Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Teacher</h2>
    <hr />
    @if (teacher is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">last_name</dt>
            <dd class="col-sm-10">@teacher.last_name</dd>
            <dt class="col-sm-2">first_name</dt>
            <dd class="col-sm-10">@teacher.first_name</dd>
            <dt class="col-sm-2">middle_name</dt>
            <dd class="col-sm-10">@teacher.middle_name</dd>
            <dt class="col-sm-2">full_name</dt>
            <dd class="col-sm-10">@teacher.full_name</dd>
            <dt class="col-sm-2">birth_date</dt>
            <dd class="col-sm-10">@teacher.birth_date</dd>
            <dt class="col-sm-2">work_since</dt>
            <dd class="col-sm-10">@teacher.work_since</dd>
            <dt class="col-sm-2">rate</dt>
            <dd class="col-sm-10">@teacher.rate</dd>
            <dt class="col-sm-2">email</dt>
            <dd class="col-sm-10">@teacher.email</dd>
            <dt class="col-sm-2">phone</dt>
            <dd class="col-sm-10">@teacher.phone</dd>
            <dt class="col-sm-2">photo</dt>
            <dd class="col-sm-10">@teacher.photo</dd>
            <dt class="col-sm-2">Disciplines</dt>
            <dd class="col-sm-10">
                @if (teacher.TeacherDisciplines != null && teacher.TeacherDisciplines.Any())
                {
                    <ul>
                        @foreach (var td in teacher.TeacherDisciplines)
                        {
                            if (td.Discipline != null)
                            {
                                <li>@td.Discipline.discipline_name</li>
                            }
                        }
                    </ul>
                }
                else
                {
                    <span>Нет назначенных дисциплин</span>
                }
            </dd>
        </dl>
        <div>
            <a href="@($"/teachers/edit?teacher_id={teacher.teacher_id}")">Edit</a> |
            <a href="@($"/teachers")">Back to List</a>
        </div>
    }
</div>

@code
{
    private Teacher? teacher;

    [SupplyParameterFromQuery]
    private int teacher_id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        using var context = DbFactory.CreateDbContext();
        
        teacher = await context.Teachers
            .Include(t => t.TeacherDisciplines)
                .ThenInclude(td => td.Discipline)
            .FirstOrDefaultAsync(m => m.teacher_id == teacher_id);

        if (teacher is null)
        {
            NavigationManager.NotFound();
        }
    }
}
