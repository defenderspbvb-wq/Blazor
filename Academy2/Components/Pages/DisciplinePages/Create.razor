@page "/disciplines/create"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@inject IDbContextFactory<Academy2Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Discipline</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm Model="Discipline" OnValidSubmit="AddDiscipline" FormName="create">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="discipline_name" class="form-label">discipline_name:</label>
                <InputText id="discipline_name" @bind-Value="Discipline.discipline_name" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Discipline.discipline_name" class="text-danger" />
            </div>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="number_of_lessons" class="form-label">number_of_lessons:</label>
                <InputNumber id="number_of_lessons" @bind-Value="Discipline.number_of_lessons" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Discipline.number_of_lessons" class="text-danger" />
            </div>

            <div class="mb-3">
                <label class="form-label"><strong>Зависимые дисциплины:</strong></label>
                <div class="card p-3" style="max-height: 200px; overflow-y: auto;">
                    @foreach (var d in allDisciplines)
                    {
                        var dId = d.discipline_id;
                        <div class="form-check mb-1">
                            <input class="form-check-input" type="checkbox" id="dep_@dId"
                                   checked="@selectedDependentIds.Contains(dId)"
                                   @onchange="(e) => ToggleId(selectedDependentIds, dId, e.Value)" />
                            <label class="form-check-label" for="dep_@dId">@d.discipline_name</label>
                        </div>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label"><strong>Требуемые дисциплины:</strong></label>
                <div class="card p-3" style="max-height: 200px; overflow-y: auto;">
                    @foreach (var d in allDisciplines)
                    {
                        var dId = d.discipline_id;
                        <div class="form-check mb-1">
                            <input class="form-check-input" type="checkbox" id="req_@dId"
                                   checked="@selectedRequiredIds.Contains(dId)"
                                   @onchange="(e) => ToggleId(selectedRequiredIds, dId, e.Value)" />
                            <label class="form-check-label" for="req_@dId">@d.discipline_name</label>
                        </div>
                    }
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/disciplines">Back to List</a>
</div>

@code
{
    private Discipline Discipline { get; set; } = new();
    private List<Discipline> allDisciplines = new();
    private HashSet<int> selectedDependentIds = new();
    private HashSet<int> selectedRequiredIds = new();

    protected override async Task OnInitializedAsync()
    {
        Discipline ??= new();
        using var context = DbFactory.CreateDbContext();
        allDisciplines = await context.Disciplines.ToListAsync();
    }

    private void ToggleId(HashSet<int> set, int id, object? isChecked)
    {
        if (isChecked is bool checkedValue && checkedValue)
            set.Add(id);
        else
            set.Remove(id);
    }

    private async Task AddDiscipline()
    {
        using var context = DbFactory.CreateDbContext();

        var dbDiscipline = new Discipline
        {
            discipline_name = Discipline.discipline_name,
            number_of_lessons = Discipline.number_of_lessons
        };

        context.Disciplines.Add(dbDiscipline);
        await context.SaveChangesAsync(); // Сохраняем, чтобы получить сгенерированный discipline_id

        foreach (var depId in selectedDependentIds)
        {
            context.DependentDisciplines.Add(new DependentDiscipline
            {
                discipline = dbDiscipline.discipline_id,
                dependent_discipline = depId
            });
            context.RequiredDisciplines.Add(new RequiredDiscipline
            {
                discipline = depId,
                required_discipline = dbDiscipline.discipline_id
            });
        }

        foreach (var reqId in selectedRequiredIds)
        {
            context.RequiredDisciplines.Add(new RequiredDiscipline
            {
                discipline = dbDiscipline.discipline_id,
                required_discipline = reqId
            });
            context.DependentDisciplines.Add(new DependentDiscipline
            {
                discipline = reqId,
                dependent_discipline = dbDiscipline.discipline_id
            });
        }


        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/disciplines");
    }

}
