@page "/disciplines/create"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@inject IDbContextFactory<Academy2Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Discipline</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm Model="Discipline" OnValidSubmit="AddDiscipline" FormName="create">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="discipline_name" class="form-label">discipline_name:</label>
                <InputText id="discipline_name" @bind-Value="Discipline.discipline_name" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Discipline.discipline_name" class="text-danger" />
            </div>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="number_of_lessons" class="form-label">number_of_lessons:</label>
                <InputNumber id="number_of_lessons" @bind-Value="Discipline.number_of_lessons" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Discipline.number_of_lessons" class="text-danger" />
            </div>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/disciplines">Back to List</a>
</div>

@code
{
    private Discipline Discipline { get; set; } = new();

    protected override void OnInitialized() => Discipline ??= new();

    private async Task AddDiscipline()
    {
        using var context = DbFactory.CreateDbContext();

        // Создаем чистый объект для базы данных
        var dbDiscipline = new Discipline
        {
            discipline_name = Discipline.discipline_name,
            number_of_lessons = Discipline.number_of_lessons
        };

        // Добавляем и сохраняем в базу данных
        context.Disciplines.Add(dbDiscipline);
        await context.SaveChangesAsync();
        
        NavigationManager.NavigateTo("/disciplines");
    }
}
