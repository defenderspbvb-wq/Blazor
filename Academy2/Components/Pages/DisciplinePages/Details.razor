@page "/disciplines/details"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@inject IDbContextFactory<Academy2Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Discipline</h2>
    <hr />
    @if (discipline is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-3">discipline_name</dt>
            <dd class="col-sm-9">@discipline.discipline_name</dd>

            <dt class="col-sm-3">number_of_lessons</dt>
            <dd class="col-sm-9">@discipline.number_of_lessons</dd>

            <dt class="col-sm-3">Teachers</dt>
            <dd class="col-sm-9">
                @if (discipline.TeacherDisciplines != null && discipline.TeacherDisciplines.Any())
                {
                    <ul class="mb-0">
                        @foreach (var td in discipline.TeacherDisciplines)
                        {
                            if (td.Teacher != null)
                            {
                                <li>@td.Teacher.full_name</li>
                            }
                        }
                    </ul>
                }
                else
                {
                    <span>Нет назначенных преподавателей</span>
                }
            </dd>

            <dt class="col-sm-3">Зависимые дисциплины</dt>
            <dd class="col-sm-9">
                @if (discipline.DependentDisciplines != null && discipline.DependentDisciplines.Any())
                {
                    <ul class="mb-0">
                        @foreach (var dd in discipline.DependentDisciplines)
                        {
                            if (dd.Dependent != null)
                            {
                                <li>@dd.Dependent.discipline_name</li>
                            }
                        }
                    </ul>
                }
                else
                {
                    <span>Нет зависимых дисциплин</span>
                }
            </dd>

            <dt class="col-sm-3">Требуемые дисциплины</dt>
            <dd class="col-sm-9">
                @if (discipline.RequiredDisciplines != null && discipline.RequiredDisciplines.Any())
                {
                    <ul class="mb-0">
                        @foreach (var rd in discipline.RequiredDisciplines)
                        {
                            if (rd.Required != null)
                            {
                                <li>@rd.Required.discipline_name</li>
                            }
                        }
                    </ul>
                }
                else
                {
                    <span>Нет требуемых дисциплин</span>
                }
            </dd>
        </dl>



        <div>
            <a href="@($"/disciplines/edit?discipline_id={discipline.discipline_id}")">Edit</a> |
            <a href="@($"/disciplines")">Back to List</a>
        </div>
    }
</div>

@code
{
    private Discipline? discipline;

    [SupplyParameterFromQuery]
    private int discipline_id { get; set; }
    protected override async Task OnParametersSetAsync()
    {
        using var context = DbFactory.CreateDbContext();
    
        discipline = await context.Disciplines
    .Include(d => d.TeacherDisciplines)
        .ThenInclude(td => td.Teacher)
    .Include(d => d.DependentDisciplines)
        .ThenInclude(dd => dd.Dependent)
    .Include(d => d.RequiredDisciplines)
        .ThenInclude(rd => rd.Required)
    .FirstOrDefaultAsync(m => m.discipline_id == discipline_id);


        if (discipline is null)
        {
            NavigationManager.NotFound();
        }
    }
}

