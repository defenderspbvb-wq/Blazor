@page "/disciplines/edit"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@inject IDbContextFactory<Academy2Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit Discipline</PageTitle>

<h1>Edit</h1>

<h2>Discipline</h2>
<hr />

@if (discipline is null || allTeachers is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <EditForm Model="discipline" OnValidSubmit="UpdateDiscipline" FormName="edit-discipline">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />

                <input type="hidden" value="@discipline.discipline_id" />

                <div class="mb-3">
                    <label for="disciplinename" class="form-label">discipline_name:</label>
                    <InputText id="disciplinename" @bind-Value="discipline.discipline_name" class="form-control" />
                    <ValidationMessage For="() => discipline.discipline_name" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="numberoflessons" class="form-label">number_of_lessons:</label>
                    <InputNumber id="numberoflessons" @bind-Value="discipline.number_of_lessons" class="form-control" />
                    <ValidationMessage For="() => discipline.number_of_lessons" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Преподаватели этой дисциплины:</strong></label>
                    <div class="card p-3" style="max-height: 250px; overflow-y: auto;">
                        @foreach (var teacher in allTeachers)
                        {
                            var tId = teacher.teacher_id;
                            <div class="form-check mb-1">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="teacher_@tId"
                                       checked="@selectedTeacherIds.Contains(tId)"
                                       @onchange="(e) => ToggleTeacher(tId, e.Value)" />
                                <label class="form-check-label" for="teacher_@tId">
                                    @teacher.full_name
                                </label>
                            </div>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Зависимые дисциплины:</strong></label>
                    <div class="card p-3" style="max-height: 200px; overflow-y: auto;">
                        @foreach (var d in otherDisciplines)
                        {
                            var dId = d.discipline_id;
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="checkbox" id="dep_@dId"
                                       checked="@selectedDependentIds.Contains(dId)"
                                       @onchange="(e) => ToggleId(selectedDependentIds, dId, e.Value)" />
                                <label class="form-check-label" for="dep_@dId">@d.discipline_name</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Требуемые дисциплины:</strong></label>
                    <div class="card p-3" style="max-height: 200px; overflow-y: auto;">
                        @foreach (var d in otherDisciplines)
                        {
                            var dId = d.discipline_id;
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="checkbox" id="req_@dId"
                                       checked="@selectedRequiredIds.Contains(dId)"
                                       @onchange="(e) => ToggleId(selectedRequiredIds, dId, e.Value)" />
                                <label class="form-check-label" for="req_@dId">@d.discipline_name</label>
                            </div>
                        }
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Save</button> |
                <a href="/disciplines">Back to List</a>
            </EditForm>
        </div>
    </div>
}

@code
{
    private Discipline? discipline;
    private List<Teacher>? allTeachers;
    private List<Discipline> otherDisciplines = new();
    
    // Хранят ID выбранных чекбоксами преподавателей и дисциплин
    private HashSet<int> selectedTeacherIds = new();
    private HashSet<int> selectedDependentIds = new();
    private HashSet<int> selectedRequiredIds = new();

    [SupplyParameterFromQuery]
    private int discipline_id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        using var context = DbFactory.CreateDbContext();

        // Загружаем дисциплину вместе со всеми её текущими связями
        discipline = await context.Disciplines
            .Include(d => d.TeacherDisciplines)
            .Include(d => d.DependentDisciplines)
            .Include(d => d.RequiredDisciplines)
            .FirstOrDefaultAsync(m => m.discipline_id == discipline_id);

        if (discipline is null)
        {
            NavigationManager.NotFound();
            return;
        }

        // Выкачиваем из базы всех преподавателей и все остальные дисциплины (исключая текущую)
        allTeachers = await context.Teachers.ToListAsync();
        otherDisciplines = await context.Disciplines
            .Where(d => d.discipline_id != discipline_id)
            .ToListAsync();

        // Заполняем хэшсеты ID уже привязанных преподавателей и дисциплин
        selectedTeacherIds = discipline.TeacherDisciplines
            .Select(td => td.teacher_id)
            .ToHashSet();

        selectedDependentIds = discipline.DependentDisciplines
            .Select(dd => dd.dependent_discipline)
            .ToHashSet();

        selectedRequiredIds = discipline.RequiredDisciplines
            .Select(rd => rd.required_discipline)
            .ToHashSet();
    }

    private void ToggleTeacher(int teacherId, object? isChecked)
    {
        ToggleId(selectedTeacherIds, teacherId, isChecked);
    }

    // Универсальный метод переключения чекбоксов
    private void ToggleId(HashSet<int> set, int id, object? isChecked)
    {
        if (isChecked is bool checkedValue && checkedValue)
        {
            set.Add(id);
        }
        else
        {
            set.Remove(id);
        }
    }

    private async Task UpdateDiscipline()
    {
        if (discipline is null) return;

        using var context = DbFactory.CreateDbContext();
        context.Attach(discipline);
        context.Entry(discipline).State = EntityState.Modified;

        // 1. Синхронизация преподавателей
        var currentRelations = await context.TeacherDisciplines
            .Where(td => td.discipline_id == discipline.discipline_id)
            .ToListAsync();

        var relationsToRemove = currentRelations
            .Where(td => !selectedTeacherIds.Contains(td.teacher_id));
        context.TeacherDisciplines.RemoveRange(relationsToRemove);

        var currentTeacherIds = currentRelations.Select(td => td.teacher_id).ToHashSet();
        foreach (var teacherId in selectedTeacherIds)
        {
            if (!currentTeacherIds.Contains(teacherId))
            {
                context.TeacherDisciplines.Add(new TeacherDiscipline
                {
                    discipline_id = discipline.discipline_id,
                    teacher_id = teacherId
                });
            }
        }

        // 2. Синхронизация зависимых дисциплин (и зеркальных требуемых)
        var currentDeps = await context.DependentDisciplines
            .Where(dd => dd.discipline == discipline.discipline_id)
            .ToListAsync();

        var depsToRemove = currentDeps
            .Where(dd => !selectedDependentIds.Contains(dd.dependent_discipline))
            .ToList();

        foreach (var rem in depsToRemove)
        {
            context.DependentDisciplines.Remove(rem);
            // Удаляем зеркальную запись из RequiredDisciplines
            var mirrorReq = await context.RequiredDisciplines
                .FirstOrDefaultAsync(rd => rd.discipline == rem.dependent_discipline && rd.required_discipline == discipline.discipline_id);
            if (mirrorReq != null) context.RequiredDisciplines.Remove(mirrorReq);
        }

        var currentDepIds = currentDeps.Select(dd => dd.dependent_discipline).ToHashSet();
        foreach (var depId in selectedDependentIds.Where(id => !currentDepIds.Contains(id)))
        {
            context.DependentDisciplines.Add(new DependentDiscipline
            {
                discipline = discipline.discipline_id,
                dependent_discipline = depId
            });

            // Добавляем зеркальную запись в RequiredDisciplines, если её ещё нет
            bool mirrorExists = await context.RequiredDisciplines
                .AnyAsync(rd => rd.discipline == depId && rd.required_discipline == discipline.discipline_id);
            if (!mirrorExists)
            {
                context.RequiredDisciplines.Add(new RequiredDiscipline
                {
                    discipline = depId,
                    required_discipline = discipline.discipline_id
                });
            }
        }

        // 3. Синхронизация требуемых дисциплин (и зеркальных зависимых)
        var currentReqs = await context.RequiredDisciplines
            .Where(rd => rd.discipline == discipline.discipline_id)
            .ToListAsync();

        var reqsToRemove = currentReqs
            .Where(rd => !selectedRequiredIds.Contains(rd.required_discipline))
            .ToList();

        foreach (var rem in reqsToRemove)
        {
            context.RequiredDisciplines.Remove(rem);
            // Удаляем зеркальную запись из DependentDisciplines
            var mirrorDep = await context.DependentDisciplines
                .FirstOrDefaultAsync(dd => dd.discipline == rem.required_discipline && dd.dependent_discipline == discipline.discipline_id);
            if (mirrorDep != null) context.DependentDisciplines.Remove(mirrorDep);
        }

        var currentReqIds = currentReqs.Select(rd => rd.required_discipline).ToHashSet();
        foreach (var reqId in selectedRequiredIds.Where(id => !currentReqIds.Contains(id)))
        {
            context.RequiredDisciplines.Add(new RequiredDiscipline
            {
                discipline = discipline.discipline_id,
                required_discipline = reqId
            });

            // Добавляем зеркальную запись в DependentDisciplines, если её ещё нет
            bool mirrorExists = await context.DependentDisciplines
                .AnyAsync(dd => dd.discipline == reqId && dd.dependent_discipline == discipline.discipline_id);
            if (!mirrorExists)
            {
                context.DependentDisciplines.Add(new DependentDiscipline
                {
                    discipline = reqId,
                    dependent_discipline = discipline.discipline_id
                });
            }
        }


        // Сохраняем все изменения в базу
        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!DisciplineExists(discipline.discipline_id, context))
            {
                NavigationManager.NotFound();
                return;
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/disciplines");
    }

    private bool DisciplineExists(int id, Academy2Context context)
    {
        return context.Disciplines.Any(e => e.discipline_id == id);
    }
}

