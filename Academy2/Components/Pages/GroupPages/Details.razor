@page "/groups/details"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@using Microsoft.AspNetCore.Components.QuickGrid
@inject IDbContextFactory<Academy2Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<div>
    @if (group is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="controls">
            <h1>@group.group_name</h1>
            <a href="@($"/groups/edit?group_id={group.group_id}")" class="btn btn-primary">Edit</a>
        </div>
        <hr />
        
        <dl class="row">
            <dt class="col-sm-2">Название группы</dt>
            <dd class="col-sm-10">@group.group_name</dd>
            
            <dt class="col-sm-2">Направление</dt>
            <dd class="col-sm-10 fw-bold">@group.Direction?.direction_name</dd>
            
            <dt class="col-sm-2">Всего студентов</dt>
            <dd class="col-sm-10"><span class="badge bg-success">@totalStudentsCount</span></dd>
            
            <dt class="col-sm-2">Дни обучения</dt>
            <dd class="col-sm-10">@(new Week((byte)(group.learning_days ?? 0)))</dd>
            
            <dt class="col-sm-2">Время начала</dt>
            <dd class="col-sm-10">@group.start_time</dd>
            
            <dt class="col-sm-2">Дата начала</dt>
            <dd class="col-sm-10">@group.start_date</dd>
        </dl>

        <h3 class="mt-4 mb-3">Студенты группы</h3>
        
        @if (hasStudents == false)
        {
            <div class="alert alert-info text-center p-3 text-muted">
                <em>В выбранной группе пока нет обучающихся студентов.</em>
            </div>
        }
        else
        {
            <div class="grid-container">
                <QuickGrid TGridItem="Student" Class="table table-striped table-bordered" ItemsProvider="StudentsDataProvider" Pagination="pagination">
                    <TemplateColumn Context="student" Title="Студент" Sortable="true" SortBy="sortBy">
                        <a href="@($"/students/details?stud_id={student.stud_id}")">@student.full_name</a>
                    </TemplateColumn>
                    
                    <PropertyColumn Property="student => student.birth_date" Title="Дата рождения" Format="dd.MM.yyyy" />
                    <PropertyColumn Property="student => student.email" Title="Email" />
                    <PropertyColumn Property="student => student.phone" Title="Телефон" />
                </QuickGrid>
            </div>
            
            <div class="page-size-chooser mt-3 mb-4">
                <Paginator State="pagination" />
            </div>
        }

        <div>
            <a href="@($"/groups")">Back to List</a>
        </div>
    }
</div>

@code
{
    private Group? group;
    private int totalStudentsCount;
    private bool? hasStudents;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 5 };
    private GridSort<Student> sortBy = GridSort<Student>.ByAscending(s => s.last_name);

    [SupplyParameterFromQuery]
    private int group_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        
        group = await context.Groups
            .Include(g => g.Direction)
            .FirstOrDefaultAsync(m => m.group_id == group_id);

        if (group is null)
        {
            NavigationManager.NotFound();
            return;
        }

        hasStudents = await context.Students.AnyAsync(s => s.group == group_id);

        totalStudentsCount = await context.Students.CountAsync(s => s.group == group_id);
    }

    private async ValueTask<GridItemsProviderResult<Student>> StudentsDataProvider(GridItemsProviderRequest<Student> request)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        
        var query = context.Students
            .Where(s => s.group == group_id)
            .AsNoTracking();

        var totalCount = await query.CountAsync(request.CancellationToken);

        query = query.OrderBy(s => s.last_name);

        var items = await query
            .Skip(request.StartIndex)
            .Take(request.Count ?? 5)
            .ToArrayAsync(request.CancellationToken);

        return GridItemsProviderResult.From(items, totalCount);
    }
}
