@page "/groups/create"
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@inject IDbContextFactory<Academy2Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Group</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Group" OnValidSubmit="AddGroup" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="group_name" class="form-label">group_name:</label>
                <InputText id="group_name" @bind-Value="Group.group_name" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Group.group_name" class="text-danger" />
            </div>
            
            <div class="mb-3">
                <label for="direction" class="form-label">direction (Направление):</label>
                <!-- ВАРИАНТ 2: Выпадающий список вместо InputNumber -->
                <InputSelect id="direction" @bind-Value="Group.direction" class="form-control">
                    <option value="0">-- Выберите направление --</option>
                    @if (allDirections != null)
                    {
                        @foreach (var dir in allDirections)
                        {
                            <option value="@dir.direction_id">@dir.direction_name</option>
                        }
                    }
                </InputSelect>
                <ValidationMessage For="() => Group.direction" class="text-danger" />
            </div>
            
            <div class="mb-3">
                <label for="learning_days" class="form-label">learning_days:</label>
                <input type="number"
                       id="learning_days"
                       name="Group.learning_days"
                       value="@Group.learning_days"
                       class="form-control" />
                <ValidationMessage For="() => Group.learning_days" class="text-danger" />
            </div>
            
            <div class="mb-3">
                <label for="start_time" class="form-label">start_time:</label>
                <InputDate Type="InputDateType.Time" id="start_time" @bind-Value="Group.start_time" class="form-control" />
                <ValidationMessage For="() => Group.start_time" class="text-danger" />
            </div>
            
            <div class="mb-3">
                <label for="start_date" class="form-label">start_date:</label>
                <InputDate id="start_date" @bind-Value="Group.start_date" class="form-control" />
                <ValidationMessage For="() => Group.start_date" class="text-danger" />
            </div>
            
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/groups">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Group Group { get; set; } = default!;

    // Список для хранения направлений из базы данных
    private List<Direction> allDirections = new();

    // Загружаем список направлений при инициализации страницы
    protected override async Task OnInitializedAsync()
    {
        Group ??= new();

        using var context = DbFactory.CreateDbContext();
        allDirections = await context.Directions
                                     .OrderBy(d => d.direction_name)
                                     .ToListAsync();
    }

    private async Task AddGroup()
    {
        using var context = DbFactory.CreateDbContext();
        context.Groups.Add(Group);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/groups");
    }
}

