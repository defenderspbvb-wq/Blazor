@page "/students"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@implements IAsyncDisposable
@inject IDbContextFactory<Academy2Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Студенты</PageTitle>

<h1>Список студентов</h1>

@* Управляющие элементы *@
<div class="controls">
    <p class="mb-0">
        <a href="students/create" class="btn btn-primary">Добавить</a>
    </p>

    <div>
        <input type="text"
               class="form-control"
               placeholder="Поиск студента..."
               @bind="searchString"
               @bind:event="oninput"
               style="width: 250px;" />
    </div>
</div>

@* Таблица *@
<div class="grid-container">
    <QuickGrid Class="table table-striped table-bordered" Items="FilteredStudents" Pagination="pagination">
        <TemplateColumn Context="student" Title="Студент" Sortable="true" SortBy="sortBy">
            <a href="@($"students/details?stud_id={student.stud_id}")">@student.full_name</a>
        </TemplateColumn>
        <PropertyColumn Property="student => student.birth_date" Title="Дата рождения" Sortable="true" Format="dd.MM.yyyy" />
        <PropertyColumn Property="student => student.Group!.group_name" Title="Группа" Sortable="true" />
        <PropertyColumn Property="student => student.Group!.Direction!.direction_name" Title="Направление" Sortable="true" />
        <TemplateColumn Context="student" Title="Действия">
            <a href="@($"students/edit?stud_id={student.stud_id}")" class="btn-action btn-action-edit">Edit</a>
            <a href="@($"students/details?stud_id={student.stud_id}")" class="btn-action btn-action-details">Details</a>
            <a href="@($"students/delete?stud_id={student.stud_id}")" class="btn-action btn-action-delete">Delete</a>
        </TemplateColumn>
    </QuickGrid>
</div>

@* Пагинация *@
<div class="page-size-chooser mt-3">
    <Paginator State="pagination" />
</div>

@code
{
    private Academy2Context context = default!;
    
    // Поле для строки поиска
    private string searchString = string.Empty;
    
    // Инициализация состояния пагинации (по 5 студентов на страницу)
    private PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

    // Настройка сортировки по умолчанию (по фамилии по возрастанию)
    private GridSort<Student> sortBy = GridSort<Student>.ByAscending(s => s.last_name);

    // Инициализация контекста при старте страницы
    protected override void OnInitialized() => context = DbFactory.CreateDbContext();
    

    // FilteredStudents для фильтрации и подгрузки связей (Eager Loading)
    private IQueryable<Student> FilteredStudents
    {
        get
        {
            var result = context.Students
            .Include(s => s.Group!)
            .ThenInclude(g => g.Direction)
            .AsNoTracking();


            if (!string.IsNullOrWhiteSpace(searchString))
            {
                result = result.Where(s => s.full_name != null && s.full_name.Contains(searchString)
                                        || s.last_name != null && s.last_name.Contains(searchString));
            }

            return result;
        }
    }

    // Асинхронное освобождение ресурсов контекста БД при закрытии страницы
    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
