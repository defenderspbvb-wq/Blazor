@page "/students/edit"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@inject IDbContextFactory<Academy2Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Редактирование</PageTitle>

@if (Student is null)
{
    <p><em>Загрузка данных студента...</em></p>
}
else
{
    <h1>Редактирование: @Student.full_name</h1>
    <h2>Студент</h2>
    <hr />
    
    <div class="row">
        <div class="col-md-8">
            <EditForm Model="Student" OnValidSubmit="UpdateStudent" FormName="edit">
                <div class="human-text-fields">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" role="alert" />
                
                    <input type="hidden" name="Student.stud_id" value="@Student.stud_id" />

                    <div class="row">
                        <div class="col-md-7">
                            <ChooseGroup Student="Student" />

                            <div class="mb-3">
                                <span class="text-danger">*</span>
                                <label for="last_name" class="form-label">Фамилия:</label>
                                <InputText id="last_name" @bind-Value="Student.last_name" class="form-control w-100" aria-required="true" />
                                <ValidationMessage For="() => Student.last_name" class="text-danger" />
                            </div>
                        
                            <div class="mb-3">
                                <span class="text-danger">*</span>
                                <label for="first_name" class="form-label">Имя:</label>
                                <InputText id="first_name" @bind-Value="Student.first_name" class="form-control w-100" aria-required="true" />
                                <ValidationMessage For="() => Student.first_name" class="text-danger" />
                            </div>
                        
                            <div class="mb-3">
                                <label for="middle_name" class="form-label">Отчество:</label>
                                <InputText id="middle_name" @bind-Value="Student.middle_name" class="form-control w-100" />
                                <ValidationMessage For="() => Student.middle_name" class="text-danger" />
                            </div>
                        
                            <div class="mb-3">
                                <span class="text-danger">*</span>
                                <label for="birth_date" class="form-label">Дата рождения:</label>
                                <InputDate id="birth_date" @bind-Value="Student.birth_date" class="form-control w-100" aria-required="true" />
                                <ValidationMessage For="() => Student.birth_date" class="text-danger" />
                            </div>
                        
                            <div class="mb-3">
                                <label for="email" class="form-label">Email:</label>
                                <InputText id="email" @bind-Value="Student.email" class="form-control w-100" />
                                <ValidationMessage For="() => Student.email" class="text-danger" />
                            </div>
                        
                            <div class="mb-3">
                                <label for="phone" class="form-label">Телефон:</label>
                                <InputText id="phone" @bind-Value="Student.phone" class="form-control w-100" />
                                <ValidationMessage For="() => Student.phone" class="text-danger" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5 border-start ps-4">
                        <Photo Human="Student" AllowChange="true" />
                        <ValidationMessage For="() => Student.photo" class="text-danger" />
                    </div>
                </div>
                
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/students">Back to List</a>
</div>

@code
{
    [SupplyParameterFromForm]
    private Student? Student { get; set; }

    [SupplyParameterFromQuery]
    private int stud_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        
        Student ??= await context.Students.FirstOrDefaultAsync(m => m.stud_id == stud_id);

        if (Student is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task UpdateStudent()
    {
        if (Student is null) return;

        using var context = await DbFactory.CreateDbContextAsync();
        
        context.Attach(Student).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!await StudentExists(Student.stud_id))
            {
                NavigationManager.NotFound();
                return;
            }
            else
            {
                throw;
            }
        }

        // NavigationManager.NavigateTo("/students");
        NavigationManager.NavigateTo($"/students/details?Stud_id={Student.stud_id}");
    }

    private async Task<bool> StudentExists(int id)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        return await context.Students.AnyAsync(e => e.stud_id == id);
    }
}
