@page "/uni"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using AcademyTest.Models
@implements IAsyncDisposable
@inject IDbContextFactory<MiniUniversityDbContext> DbFactory

<PageTitle>CRUD - Университет</PageTitle>

<div class="container mt-4">
    <h2 class="mb-4 text-center text-primary">Управление ведомостями «MiniUniversityDB» (CRUD)</h2>

    <!-- ========================================================================= -->
    <!-- 1. CREATE (СОЗДАНИЕ): ФОРМА ЗАЧИСЛЕНИЯ СТУДЕНТА                           -->
    <!-- ========================================================================= -->
    <div class="card shadow mb-4 border-primary">
        <div class="card-header bg-primary text-white fw-bold">
            👤 [CREATE] Зачисление нового студента
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <input type="text" class="form-control" placeholder="Имя" @bind="newFirstName" />
                </div>
                <div class="col-md-3">
                    <input type="text" class="form-control" placeholder="Фамилия" @bind="newLastName" />
                </div>
                <div class="col-md-4">
                    <select class="form-select" @bind="selectedGroupId">
                        <option value="0">-- Выберите группу --</option>
                        @if (allGroups != null)
                        {
                            @foreach (var g in allGroups)
                            {
                                <option value="@g.GroupId">@g.GroupName</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-success w-100" @onclick="CreateStudent">Добавить</button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="alert alert-info mt-3 mb-0 py-2">@statusMessage</div>
            }
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 2. READ / UPDATE / DELETE: ТАБЛИЦЫ ВЕДОМОСТЕЙ                             -->
    <!-- ========================================================================= -->
    @if (coursesList == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Загрузка данных...</p>
        </div>
    }
    else
    {
        @foreach (var course in coursesList)
        {
            <div class="card shadow mb-5 border-0">
                <div class="card-header bg-dark text-white p-3">
                    <h4 class="mb-0">📚 Курс: @course.CourseName</h4>
                </div>
                <div class="card-body bg-light">
                    @if (!course.Groups.Any())
                    {
                        <p class="text-muted mb-0">Групп пока нет.</p>
                    }
                    else
                    {
                        @foreach (var group in course.Groups)
                        {
                            <div class="card m-3 border-secondary shadow-sm">
                                <div class="card-header bg-secondary text-white fw-bold">
                                    👥 Группа: @group.GroupName
                                </div>
                                <div class="card-body p-0">
                                    <table class="table table-hover table-striped mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Студент</th>
                                                <th class="text-center" style="width: 180px;">Оценка [UPDATE]</th>
                                                <th class="text-center" style="width: 120px;">Действие [DELETE]</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!group.Enrollments.Any())
                                            {
                                                <tr>
                                                    <td colspan="3" class="text-muted text-center py-3">Студентов нет.</td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var enrollment in group.Enrollments)
                                                {
                                                    <tr>
                                                        <td class="align-middle">
                                                            @enrollment.Student.FirstName @enrollment.Student.LastName
                                                        </td>
                                                        <td class="text-center align-middle">
                                                            <!-- UPDATE: При изменении числа в инпуте сразу вызывается UpdateGrade -->
                                                            <input type="number" class="form-control form-control-sm d-inline-block text-center fw-bold" 
                                                                   style="width: 70px;" min="1" max="5"
                                                                   value="@enrollment.Grade" 
                                                                   @onchange="(e) => UpdateGrade(enrollment, e.Value)" />
                                                        </td>
                                                        <td class="text-center align-middle">
                                                            <!-- DELETE: Кнопка удаления записи из журнала -->
                                                            <button class="btn btn-danger btn-sm" 
                                                                    @onclick="() => DeleteEnrollment(enrollment)">
                                                                🗑 Отчислить
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private MiniUniversityDbContext? context;
    private List<Course>? coursesList;
    private List<Group>? allGroups;

    // Переменные формы создания (Create)
    private string newFirstName = "";
    private string newLastName = "";
    private int selectedGroupId = 0;
    private string statusMessage = "";

    protected override async Task OnInitializedAsync()
    {
        // Порождаем контекст из фабрики
        context = await DbFactory.CreateDbContextAsync();
        await ReadAllData();
    }

    // =========================================================================
    // [READ] — Чтение данных (Жадная загрузка разделенными запросами)
    // =========================================================================
    private async Task ReadAllData()
    {
        if (context == null) return;

        coursesList = await context.Courses
            .Include(c => c.Groups)
                .ThenInclude(g => g.Enrollments)
                    .ThenInclude(e => e.Student)
            .AsSplitQuery() // Оптимизация разделением запросов
            .ToListAsync();

        allGroups = await context.Groups.ToListAsync();
    }

    // =========================================================================
    // [CREATE] — Создание студента и привязка к группе
    // =========================================================================
    private async Task CreateStudent()
    {
        if (string.IsNullOrWhiteSpace(newFirstName) || string.IsNullOrWhiteSpace(newLastName) || selectedGroupId == 0)
        {
            statusMessage = "Заполните все поля!";
            return;
        }

        // Создаем сущность студента
        var student = new Student { FirstName = newFirstName, LastName = newLastName };
        context!.Students.Add(student);

        // Создаем сущность связи в журнале
        var enrollment = new Enrollment { Student = student, GroupId = selectedGroupId, Grade = null };
        context.Enrollments.Add(enrollment);

        // Фиксируем транзакцию в SQL Server (INSERT INTO...)
        await context.SaveChangesAsync();

        statusMessage = $"Студент {student.FirstName} успешно зачислен!";
        newFirstName = ""; newLastName = ""; selectedGroupId = 0;
        
        await ReadAllData(); // Обновляем экран
    }

    // =========================================================================
    // [UPDATE] — Обновление оценки студента в группе
    // =========================================================================
    private async Task UpdateGrade(Enrollment enrollment, object? newValue)
    {
        if (context == null) return;

        // Конвертируем введенное пользователем значение в nullable int
        if (int.TryParse(newValue?.ToString(), out int parsedGrade))
        {
            if (parsedGrade >= 1 && parsedGrade <= 5)
            {
                // Магия EF Core: мы меняем свойство объекта, фреймворк сам отслеживает 
                // изменения (Change Tracking) и ставит объекту статус "Modified"
                enrollment.Grade = parsedGrade;
            }
            else
            {
                statusMessage = "Оценка должна быть от 1 до 5!";
                await ReadAllData(); // Сбрасываем некорректный ввод на экране
                return;
            }
        }
        else
        {
            enrollment.Grade = null; // Если поле стерли, ставим NULL в базе данных
        }
        // Синхронизируем изменения с базой (Сгенерирует UPDATE Enrollments SET Grade = ... WHERE ...)
        await context.SaveChangesAsync();
        statusMessage = "Оценка успешно обновлена!";
    }
    // =========================================================================
    // [DELETE] — Удаление зачисления (отчисление из группы)
    // =========================================================================
    private async Task DeleteEnrollment(Enrollment enrollment)
    {
        if (context == null) return;
        // Передаем объект в метод Remove. EF Core ставит ему статус "Deleted"
        context.Enrollments.Remove(enrollment);
        // Сохраняем изменения (Сгенерирует DELETE FROM Enrollments WHERE StudentId = ... AND GroupId = ...)
        await context.SaveChangesAsync();
        statusMessage = "Запись о зачислении успешно удалена!";
        await ReadAllData(); // Обновляем списки
    }
    public async ValueTask DisposeAsync()
    {
        if (context != null) await context.DisposeAsync();
    }
}